    "lint": "eslint apps packages",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
