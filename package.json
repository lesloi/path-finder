{
  "name": "path-finder",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @path-finder/mobile start",
    "android": "pnpm --filter @path-finder/mobile android",
    "ios": "pnpm --filter @path-finder/mobile ios",
    "web": "pnpm --filter @path-finder/mobile web",
    "test": "jest",
    "test:integration": "echo 'No integration tests yet (see #13)'",
    "lint": "eslint apps packages",
    "typecheck": "pnpm -r typecheck",
    "expo-doctor": "cd apps/mobile && pnpm dlx expo-doctor"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0"
  }
}
