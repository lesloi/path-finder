{
  "name": "path-finder",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "scripts/dev.sh",
    "build": "pnpm --filter @path-finder/web build",
    "start": "cd apps/server && CGO_ENABLED=0 go run .",
    "format": "prettier --write .",
    "check": "prettier --check . && pnpm check:web && pnpm check:server",
    "check:web": "eslint apps e2e && pnpm -r typecheck",
    "check:server": "apps/server/check.sh",
    "test": "pnpm test:web && pnpm test:server",
    "test:web": "vitest run",
    "test:server": "apps/server/test.sh unit",
    "test:integration": "apps/server/test.sh integration",
    "test:e2e": "pnpm --filter @path-finder/e2e test",
    "coverage": "pnpm coverage:web && pnpm coverage:server",
    "coverage:web": "vitest run --coverage",
    "coverage:server": "apps/server/coverage.sh"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
