  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @path-finder/web build",
    "start": "pnpm --filter @path-finder/api start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
